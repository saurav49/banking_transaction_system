NODE_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

DATABASE_URL=postgresql://banking:root123@localhost:5432/banking?schema=public

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=banking-transaction-system

LOG_LEVEL=debug

FRAUD_MAX_AMOUNT_MINOR=5000000
FRAUD_WINDOW_SECONDS=60
FRAUD_MAX_TRANSACTIONS=5

CONSUMER_MAX_RETRIES=5
CONSUMER_RETRY_BASE_MS=1000
TRANSACTION_FINALIZATION_TIMEOUT_SECONDS=30

# Generate a strong secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ISSUER=banking-transaction-system
JWT_AUDIENCE=banking-transaction-api
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=86400

# Used only by `bun run seed`; never use these example values in production.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-With-A-Strong-Password-123!

JWT_ACCESS_SECRET=

MAX_TXN=5
FRAUD_TXN_AMOUNT = 5000000